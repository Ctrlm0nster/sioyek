# Doxyfile for Sioyek
# Configuration for automated API reference and architecture documentation.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Sioyek"
PROJECT_NUMBER         = "3.0.0-dev"
PROJECT_BRIEF          = "Fast PDF viewer for technical books and research papers with Qt6, Vulkan QRhi hardware acceleration, and MuPDF concurrency"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
RESOLVE_UNNAMED_PARAMS = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
HIDE_COMPOUND_REFERENCE= NO
SHOW_HEADERFILE        = YES
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = NO
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO

# Warnings and logging
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Inputs and filters
INPUT                  = README.md \
                         docs/hub.md \
                         docs/user-guide.md \
                         docs/keybindings.md \
                         docs/configuration.md \
                         docs/synctex.md \
                         docs/troubleshooting.md \
                         docs/architecture.md \
                         pdf_viewer \
                         BUILDING.md \
                         PACKAGING.md \
                         RELEASE.md \
                         CHANGELOG.md \
                         LICENSES.md

USE_MDFILE_AS_MAINPAGE = README.md

FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.md

RECURSIVE              = YES

EXCLUDE                = pdf_viewer/rapidfuzz_amalgamated.hpp \
                         pdf_viewer/synctex

EXCLUDE_PATTERNS       = */rapidfuzz_amalgamated.hpp \
                         */stb_*.h \
                         */synctex/* \
                         */mupdf/* \
                         */build/* \
                         */tests/*

EXAMPLE_RECURSIVE      = NO

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES

# HTML Output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
LAYOUT_FILE            = docs/doxygen-awesome/DoxygenLayout.xml
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = docs/doxygen-awesome/header.html
HTML_FOOTER            = docs/doxygen-awesome/footer.html
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome/doxygen-awesome.css \
                         docs/doxygen-awesome/doxygen-awesome-sidebar-only.css \
                         docs/doxygen-awesome/sioyek.css
HTML_EXTRA_FILES       = docs/doxygen-awesome/doxygen-awesome-darkmode-toggle.js \
                         docs/doxygen-awesome/doxygen-awesome-paragraph-link.js \
                         docs/doxygen-awesome/doxygen-awesome-interactive-toc.js \
                         LICENSE
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 335
EXT_LINKS_IN_WINDOW    = NO
HTML_FORMULA_FORMAT    = png
SEARCHENGINE           = YES
MERMAID_RENDER_MODE    = CLIENT_SIDE
MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs

# LaTeX Output
GENERATE_LATEX         = NO

# Dot / Graphviz Configuration
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 25
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 250
MAX_DOT_GRAPH_DEPTH    = 0
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES
